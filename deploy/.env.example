# Docker 部署的配置。复制为 .env（cp .env.example .env）后按需修改；下面都是可以直接使用的默认值。
# .env 含密码，不要提交。修改后执行 docker compose up -d 生效。

# ── 一键升级 ──
# 启用页面左上角的「一键升级」：会多运行一个 upgrader 容器，见 compose.yml。不需要时删掉这一行
COMPOSE_PROFILES=upgrader

# ── 镜像 ──
# 建议固定版本号，例如 ghcr.io/tel9980/niulai:2026.10.26（对应 git 标签 v2026.10.26）；latest 是最近一次发布的版本。一键升级会改写这一行
NIULAI_IMAGE=ghcr.io/tel9980/niulai:latest

# ── 端口 ──
# niulai 在宿主机上监听的地址和端口，页面和 API 都在这个端口上。端口被占用时改这里
# 0.0.0.0 = 所有网卡（Dockge/远程访问需要）；127.0.0.1 = 只能本机访问
NIULAI_LISTEN_ADDR=0.0.0.0
NIULAI_PORT=2606

# ── 第一个管理员 ──
# 只在第一次启动时用一次：创建第一个管理员的账号和密码，不设置时都是 niulai。
# 之后修改这里没有效果：密码在网页「我的」页面改，其他用户由管理员在「用户」页添加
NIULAI_ADMIN_USER=niulai
NIULAI_ADMIN_PASSWORD=niulai

# ── 数据库 ──
# 默认连接同一个 compose 中的内置 PostgreSQL；要用自己的数据库，把连接串换成它（PostgreSQL 16 或以上）
DATABASE_URL=postgres://niulai:niulai@postgres:5432/niulai
# 页面读取缓存（Compose 内置 Redis；也可以改成外部 Redis 地址）
REDIS_URL=redis://redis:6379
# 内置数据库的密码，要与上面连接串中的密码一致。只在第一次启动（创建数据目录）之前修改才生效
POSTGRES_PASSWORD=niulai
# 内置数据库的数据目录：宿主机上的普通目录，删除容器、docker compose down -v 都不影响，备份和搬迁时直接看得到。
# 不要删除它；要放到另一块磁盘时改成那里的路径
POSTGRES_DATA=./data/postgres
# 连接池上限
NIULAI_DB_MAX_CONNECTIONS=20

# ── 同步 ──
# 同时执行的同步任务数
NIULAI_WORKER_CONCURRENCY=3
# 每秒请求同花顺接口的次数
NIULAI_RATE_LIMIT_RPS=2
# 请求同花顺接口的超时秒数
NIULAI_HTTP_TIMEOUT_S=60
# 是否运行定时同步；同步时间在网页的数据同步页上修改
NIULAI_SCHEDULER_ENABLED=true

# ── 日志 ──
RUST_LOG=info,sqlx=warn,tower_http=info

# ── 同花顺 API Key ──
# 一般不在这里填：启动后第一次打开网页时按引导配置（在 https://fuyao.aicubes.cn/admin/ 生成）。
# 填了就优先使用这里的值，网页上不能修改
# HITHINK_FINANCE_API_KEY=
